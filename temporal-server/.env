COMPOSE_PROJECT_NAME=temporal
CASSANDRA_VERSION=3.11.9
ELASTICSEARCH_VERSION=7.16.2
MYSQL_VERSION=8
POSTGRESQL_VERSION=14
TEMPORAL_VERSION=1.22.4
TEMPORAL_UI_VERSION=2.22.3
COMPOSE_CONVERT_WINDOWS_PATHS=1
POSTGRES_USER=temporal
PGADMIN_DEFAULT_EMAIL=EMAIL
POSTGRES_PASSWORD=PASSWORD
POSTGRES_PORT=5432
POSTGRES_HOST=temporal-postgresql
DATABASE_NAME=temporal-airlines-concept
CONNECTION_STRING=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=${DATABASE_NAME};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
